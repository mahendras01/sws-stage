# Local SWS runtime assets and historical backups (do not track)
# Keep the folders in Git so they exist on clone, but ignore contents except .gitkeep
/private/*
!/private/.gitkeep
/receipts/*
!/receipts/.gitkeep
/annual_maintenance_receipts/*
!/annual_maintenance_receipts/.gitkeep
/backups_pre_pg_migration/*
!/backups_pre_pg_migration/.gitkeep
/supabase/*
!/supabase/.gitkeep

# do not ignore public/ because Next.js needs static assets

